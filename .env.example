# Настройки запуска. Файл необязателен: без него используются значения по умолчанию.
# Чтобы переопределить что-то, скопируйте файл в .env — docker compose подхватит его сам.
#
#   cp .env.example .env

# Порт на хосте, по которому открывается админка.
# Слушается только на 127.0.0.1: у приложения нет авторизации.
HOST_PORT=8080

# Где хранить файл SQLite. Каталог монтируется в контейнер как /data.
DATA_DIR=./data

# Таймаут одного запроса к сайту вакансии при проверке активности.
CHECK_TIMEOUT=10s

# Сколько ссылок опрашивать параллельно при «Опросить все».
CHECK_CONCURRENCY=4

# Уровень логирования backend: debug | info | warn | error
LOG_LEVEL=info

# --- Языковые модели (Этап 2) ---
#
# Ключи необязательны. Без них приложение работает как на Этапе 1: заполнение
# карточки через модель просто недоступно, кнопка выключена.
# Провайдер и модель выбираются вручную перед каждым запуском — ничего
# не запускается по расписанию, все траты инициируете вы.

# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Списки доступных моделей через запятую. Первая предвыбирается в интерфейсе,
# поэтому первой стоит ставить самую дешёвую.
# LLM_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# LLM_CLAUDE_MODELS=claude-sonnet-4-5,claude-opus-4-1
# LLM_DEEPSEEK_MODELS=deepseek-chat

# Цены за 1M токенов для оценки стоимости запуска. Если не задать, в журнале
# будут только токены, без суммы: устаревшая цена хуже честного «неизвестно».
# LLM_GEMINI_PRICE_INPUT=0.30
# LLM_GEMINI_PRICE_OUTPUT=2.50

# Таймаут запроса к модели.
# LLM_TIMEOUT=60s

# Таймаут скачивания страницы вакансии.
# LLM_FETCH_TIMEOUT=15s

# Сколько символов очищенного текста страницы отдавать модели.
# LLM_MAX_PAGE_CHARS=40000
